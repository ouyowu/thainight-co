# Canonical origin for this site. Leave unset to use https://thainight-co.vercel.app.
# Only set to https://thainight.co once that domain actually serves this site.
NEXT_PUBLIC_SITE_URL=

# GA4 measurement ID (G-XXXXXXXXXX). Unset = no analytics script.
# Every rel="sponsored" link click is sent as an `affiliate_click` event.
NEXT_PUBLIC_GA_ID=

# Affiliate URLs. Blocks that use an empty value are hidden, not shown as dead links.
# These hotel keys already have a city-wide Agoda search in lib/affiliates.ts.
# Leave them empty to use that default. Set one only to replace it.
# Bangkok (and Sukhumvit): cid=1969005&city=9395
# Pattaya (Walking Street and Beach Road use the same city search): city=8584
# Phuket: city=16056
# Chiang Mai: city=7401
# Koh Samui city=17198 was verified but this site has no Samui hotel button.
NEXT_PUBLIC_AFFILIATE_HOTEL_BANGKOK=
NEXT_PUBLIC_AFFILIATE_HOTEL_PATTAYA=
NEXT_PUBLIC_AFFILIATE_HOTEL_SUKHUMVIT=
NEXT_PUBLIC_AFFILIATE_HOTEL_WALKING_STREET=
NEXT_PUBLIC_AFFILIATE_HOTEL_BEACH_ROAD=
NEXT_PUBLIC_AFFILIATE_HOTEL_CHIANG_MAI=
# Activity, transfer and eSIM keys below have Klook defaults (AID 139170) in lib/affiliates.ts.
# Leave them empty to use those defaults. Set one only to replace it.
NEXT_PUBLIC_AFFILIATE_KLOOK=
NEXT_PUBLIC_AFFILIATE_ALCAZAR_PATTAYA=
NEXT_PUBLIC_AFFILIATE_MUAY_THAI_BANGKOK=
NEXT_PUBLIC_AFFILIATE_MUAY_THAI_PATTAYA=
NEXT_PUBLIC_AFFILIATE_CABARET_BANGKOK=
NEXT_PUBLIC_AFFILIATE_CABARET_PATTAYA=
NEXT_PUBLIC_AFFILIATE_DINNER_CRUISE=
NEXT_PUBLIC_AFFILIATE_ROOFTOP_BANGKOK=
NEXT_PUBLIC_AFFILIATE_TRANSFER_BKK_PATTAYA=
NEXT_PUBLIC_AFFILIATE_ESIM=
NEXT_PUBLIC_AFFILIATE_HOTEL_PHUKET=
NEXT_PUBLIC_AFFILIATE_CABARET_PHUKET=
NEXT_PUBLIC_AFFILIATE_MUAY_THAI_PHUKET=
NEXT_PUBLIC_AFFILIATE_TRANSFER_PHUKET_AIRPORT=
